# ---------------------------------------------------------------- 必填
# PostgreSQL 连接串。与数据库同机部署时直接指向本地端口：
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/job_harvester

# ------------------------------------------------ 数据库在远端时才需要
# SSH 主机别名。设了它，scripts/tunnel.sh 与 harvest-cron.sh 才会建隧道；
# 留空 / 注释掉 = 认为数据库在本机，跳过隧道。
#
# 隧道模式下 DATABASE_URL 要改成指向隧道的本地端口（默认 15432，
# 因为本机 5432 常已被本地 postgres 占用）：
#   DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:15432/job_harvester
# SSH_HOST=your-server-alias

# ---------------------------------------------------------------- 可选
# 采集命令。留空则用 `uv run harvest`。
# 若用 conda / venv 等其他方式管理环境，指向该环境里的 harvest 可执行文件：
# HARVEST_CMD=/path/to/env/bin/harvest

# 出口代理。留空 = 直连（默认）。
# 只在某个源开始按 IP 封禁时才有必要启用 —— 免费代理池实测比直连慢 10~100 倍，
# 详见 docs/sources-analysis.md 附录。
# PROXY_URL=http://127.0.0.1:PORT

USER_AGENT="job-harvester/0.1 (+https://github.com/minner-fun/job-harvester)"
REQUEST_DELAY=1.0
CONCURRENCY=4
HTTP_TIMEOUT=30
